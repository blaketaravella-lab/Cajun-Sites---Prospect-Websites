{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "therapeutic-massage.cajunsites.com" }],
      "destination": "/therapeutic-massage/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "follicle-hair-solutions.cajunsites.com" }],
      "destination": "/follicle-hair-solutions/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "were-all-en-learning-center.cajunsites.com" }],
      "destination": "/were-all-en-learning-center/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "dke-cleaning-services.cajunsites.com" }],
      "destination": "/dke-cleaning-services/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "divaology-hair-studio.cajunsites.com" }],
      "destination": "/divaology-hair-studio/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "the-diesel-lab.cajunsites.com" }],
      "destination": "/the-diesel-lab/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "up-to-code-plumbing.cajunsites.com" }],
      "destination": "/up-to-code-plumbing/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "southern-classic-automotives.cajunsites.com" }],
      "destination": "/southern-classic-automotives/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "vinces-auto-repair.cajunsites.com" }],
      "destination": "/vinces-auto-repair/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "dm-and-m-auto.cajunsites.com" }],
      "destination": "/dm-and-m-auto/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "artistic-designs-flower-shoppe.cajunsites.com" }],
      "destination": "/artistic-designs-flower-shoppe/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "the-pottings-shed-florist.cajunsites.com" }],
      "destination": "/the-pottings-shed-florist/$1"
    },
    { "source": "/therapeutic-massage", "destination": "/therapeutic-massage/index.html" },
    { "source": "/follicle-hair-solutions", "destination": "/follicle-hair-solutions/index.html" },
    { "source": "/were-all-en-learning-center", "destination": "/were-all-en-learning-center/index.html" },
    { "source": "/dke-cleaning-services", "destination": "/dke-cleaning-services/index.html" },
    { "source": "/divaology-hair-studio", "destination": "/divaology-hair-studio/index.html" },
    { "source": "/the-diesel-lab", "destination": "/the-diesel-lab/index.html" },
    { "source": "/up-to-code-plumbing", "destination": "/up-to-code-plumbing/index.html" },
    { "source": "/southern-classic-automotives", "destination": "/southern-classic-automotives/index.html" },
    { "source": "/vinces-auto-repair", "destination": "/vinces-auto-repair/index.html" },
    { "source": "/dm-and-m-auto", "destination": "/dm-and-m-auto/index.html" },
    { "source": "/artistic-designs-flower-shoppe", "destination": "/artistic-designs-flower-shoppe/index.html" },
    { "source": "/the-pottings-shed-florist", "destination": "/the-pottings-shed-florist/index.html" }
  ]
}
